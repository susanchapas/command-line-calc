# Copy to .env to override calculator settings.

# Base directories (created on startup if missing).
CALCULATOR_LOG_DIR=logs
CALCULATOR_HISTORY_DIR=history

# History settings.
CALCULATOR_MAX_HISTORY_SIZE=100
CALCULATOR_AUTO_SAVE=true

# Calculation settings.
CALCULATOR_PRECISION=10
CALCULATOR_MAX_INPUT_VALUE=1e12
CALCULATOR_DEFAULT_ENCODING=utf-8

# File names, resolved inside the directories above.
CALCULATOR_LOG_FILE=calculator.log
CALCULATOR_HISTORY_FILE=calculator_history.csv
